// KEA by Atiana – data model (plan section 6, task 2.2).
// Retreats, deposits and blog are NOT part of the project (removed 2026-11-09).
// Rules: times in UTC; business time zone Europe/Dublin; money in cents, currency EUR.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum Role {
  USER
  ADMIN
}

enum OfferingType {
  GROUP_CLASS
  ONE_TO_ONE
  EVENT
}

// How an EVENT offering is paid (null for classes and 1:1)
enum EventPricing {
  FREE
  DONATION
  PAID
}

enum Mode {
  ONLINE
  IN_PERSON
}

enum SessionStatus {
  SCHEDULED
  CANCELLED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  ATTENDED
  NO_SHOW
}

enum PaidWith {
  STRIPE
  CREDIT
  FREE
}

enum CreditSource {
  PURCHASE
  REFERRAL
  ADMIN
  CANCELLATION // 1 credit given when a card-paid booking was cancelled early (client chose credit)
}

enum ProductType {
  PHYSICAL
  DIGITAL
}

enum OrderItemType {
  CLASS
  PACKAGE
  ONE_TO_ONE
  EVENT
  PRODUCT
  DONATION
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  REFUNDED
  CANCELLED
}

enum DiscountKind {
  PERCENT
  AMOUNT
}

enum ReferralStatus {
  PENDING
  QUALIFIED
  REWARDED
}

enum SubscriberStatus {
  PENDING
  ACTIVE
  UNSUBSCRIBED
}

// ---------- Users and Auth.js ----------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  emailVerified DateTime?
  image         String?
  role          Role      @default(USER)
  referralCode  String?   @unique
  referredById  String?
  referredBy    User?     @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referredUsers User[]    @relation("UserReferrals")
  timezone      String    @default("Europe/Dublin")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  bookings          Booking[]
  creditGrants      CreditGrant[]
  orders            Order[]
  referralsMade     Referral[]    @relation("Referrer")
  referralsReceived Referral[]    @relation("ReferredUser")

  @@index([referredById])
}

// Auth.js (NextAuth) adapter tables. The model is named "Session" by Auth.js;
// our dated class occurrence is therefore called ClassSession.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Offerings, sessions, prices ----------

model Offering {
  id           String        @id @default(cuid())
  type         OfferingType
  title        String
  slug         String        @unique
  summary      String        @default("")
  body         String        @default("") // markdown
  image        String?
  mode         Mode          @default(ONLINE)
  location     String?
  published    Boolean       @default(false)
  eventPricing EventPricing? // only for type EVENT
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  sessions     ClassSession[]
  priceOptions PriceOption[]

  @@index([type, published])
}

// One dated occurrence of an offering. 1:1 slots are ClassSession rows with capacity 1
// (no separate AvailabilitySlot table: one booking engine for classes, 1:1 and events).
model ClassSession {
  id         String        @id @default(cuid())
  offeringId String
  offering   Offering      @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  startsAt   DateTime // UTC
  endsAt     DateTime // UTC
  capacity   Int           @default(1)
  zoomUrl    String?
  location   String?
  status     SessionStatus @default(SCHEDULED)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  bookings Booking[]

  @@unique([offeringId, startsAt]) // one occurrence per offering and start time (idempotent demo seed)
  @@index([offeringId, startsAt])
  @@index([startsAt])
}

model PriceOption {
  id          String   @id @default(cuid())
  offeringId  String
  offering    Offering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  name        String // e.g. "Single class", "Online 1:1"
  amountCents Int
  currency    String   @default("EUR")
  createdAt   DateTime @default(now())

  @@index([offeringId])
}

// Class pack / 1:1 pack
model Package {
  id         String         @id @default(cuid())
  name       String
  credits    Int
  validDays  Int
  priceCents Int
  currency   String         @default("EUR")
  appliesTo  OfferingType[]
  active     Boolean        @default(true)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  creditGrants CreditGrant[]
}

model CreditGrant {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  packageId      String?
  package        Package?       @relation(fields: [packageId], references: [id], onDelete: SetNull)
  creditsTotal   Int
  creditsLeft    Int
  expiresAt      DateTime?
  expiredAt      DateTime? // set by the daily cron when the unused credits were removed
  creditsExpired Int            @default(0) // how many unused credits the cron removed
  appliesTo      OfferingType[] @default([GROUP_CLASS]) // copied from the package when granted
  source         CreditSource
  createdAt      DateTime       @default(now())

  bookings Booking[]
  referral Referral? // set when this grant is a referral reward

  @@index([userId, expiresAt])
}

// ---------- Bookings and orders ----------

model Booking {
  id                   String        @id @default(cuid())
  userId               String
  user                 User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  sessionId            String
  session              ClassSession  @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  status               BookingStatus @default(PENDING)
  paidWith             PaidWith?
  creditGrantId        String?
  creditGrant          CreditGrant?  @relation(fields: [creditGrantId], references: [id], onDelete: SetNull)
  disclaimerAcceptedAt DateTime?
  reminderSentAt       DateTime? // 24 h reminder (daily cron); set once
  // Database guarantees against double booking (NULL when the booking is not active):
  //   userKey = "<sessionId>:<userId>" -> the same person cannot hold two seats in one session
  //   slotKey = "<sessionId>"          -> only for capacity-1 sessions (1:1): one active booking per slot
  userKey              String?       @unique
  slotKey              String?       @unique
  orderId              String?
  order                Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([userId])
  @@index([sessionId, status])
  @@index([orderId])
}

model Product {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  description String      @default("")
  priceCents  Int
  stock       Int         @default(0)
  type        ProductType @default(PHYSICAL)
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  images     ProductImage[]
  orderItems OrderItem[]
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String  @default("")
  position  Int     @default(0)

  @@index([productId])
}

model Order {
  id                    String        @id @default(cuid())
  userId                String? // guests may pay (shop, donations): then email is used
  user                  User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  email                 String
  status                OrderStatus   @default(PENDING)
  currency              String        @default("EUR")
  subtotalCents         Int           @default(0)
  shippingCents         Int           @default(0)
  discountCents         Int           @default(0)
  totalCents            Int           @default(0)
  discountCodeId        String?
  discountCode          DiscountCode? @relation(fields: [discountCodeId], references: [id], onDelete: SetNull)
  stripeSessionId       String?       @unique
  stripePaymentIntentId String? // saved by the webhook; used for refunds
  paidAt                DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  items    OrderItem[]
  bookings Booking[]

  @@index([userId])
  @@index([email])
  @@index([stripePaymentIntentId])
}

model OrderItem {
  id             String        @id @default(cuid())
  orderId        String
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type           OrderItemType
  description    String
  quantity       Int           @default(1)
  unitPriceCents Int
  totalCents     Int
  productId      String?
  product        Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  refId          String? // id of the session / package / offering this line is for

  @@index([orderId])
}

// Idempotency for the Stripe webhook (one row per processed Stripe event id).
model StripeEvent {
  id          String   @id // Stripe event id
  type        String
  processedAt DateTime @default(now())
}

model DiscountCode {
  id             String       @id @default(cuid())
  code           String       @unique
  kind           DiscountKind
  percentOff     Int? // for PERCENT
  amountOffCents Int? // for AMOUNT
  maxUses        Int?
  usedCount      Int          @default(0)
  expiresAt      DateTime?
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())

  orders Order[]
}

// ---------- Referral, content, newsletter ----------

model Referral {
  id                  String         @id @default(cuid())
  referrerId          String
  referrer            User           @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referredUserId      String         @unique // one reward per new client
  referredUser        User           @relation("ReferredUser", fields: [referredUserId], references: [id], onDelete: Cascade)
  status              ReferralStatus @default(PENDING)
  rewardCreditGrantId String?        @unique
  rewardCreditGrant   CreditGrant?   @relation(fields: [rewardCreditGrantId], references: [id], onDelete: SetNull)
  createdAt           DateTime       @default(now())

  @@index([referrerId])
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  text      String
  published Boolean  @default(true)
  createdAt DateTime @default(now())
}

model NewsletterSubscriber {
  id           String           @id @default(cuid())
  email        String           @unique
  status       SubscriberStatus @default(PENDING)
  consentAt    DateTime?
  confirmToken String?          @unique
  source       String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}

model SiteSetting {
  key   String @id
  value String
}
