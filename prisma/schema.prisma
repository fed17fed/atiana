// KEA by Atiana – data model (plan section 6, task 2.2).
// Retreats, deposits and blog are NOT part of the project (removed 2026-11-09).
// Rules: times in UTC; business time zone Europe/Dublin; money in cents, currency EUR.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum Role {
  USER
  ADMIN
}

enum OfferingType {
  GROUP_CLASS
  ONE_TO_ONE
  EVENT
}

// How an EVENT offering is paid (null for classes and 1:1)
enum EventPricing {
  FREE
  DONATION
  PAID
}

enum Mode {
  ONLINE
  IN_PERSON
}

enum SessionStatus {
  SCHEDULED
  CANCELLED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  ATTENDED
  NO_SHOW
}

enum PaidWith {
  STRIPE
  CREDIT
  FREE
}

enum CreditSource {
  PURCHASE
  REFERRAL
  ADMIN
  CANCELLATION // 1 credit given when a card-paid booking was cancelled early (client chose credit)
}

enum OrderItemType {
  CLASS
  PACKAGE
  ONE_TO_ONE
  EVENT
  DONATION
}

enum OrderStatus {
  PENDING
  PAID
  REFUNDED
  CANCELLED
}

enum DiscountKind {
  PERCENT
  AMOUNT
}

enum ReferralStatus {
  PENDING
  QUALIFIED
  REWARDED
}

enum SubscriberStatus {
  PENDING
  ACTIVE
  UNSUBSCRIBED
}

// ---------- Users and Auth.js ----------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  emailVerified DateTime?
  image         String?
  role          Role      @default(USER)
  referralCode  String?   @unique
  referredById  String?
  referredBy    User?     @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referredUsers User[]    @relation("UserReferrals")
  timezone      String    @default("Europe/Dublin")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts             Account[]
  sessions             Session[]
  bookings             Booking[]
  creditGrants         CreditGrant[]
  orders               Order[]
  referralsMade        Referral[]        @relation("Referrer")
  referralsReceived    Referral[]        @relation("ReferredUser")
  adminAuditLogs       AdminAuditLog[]
  contentBlocksUpdated ContentBlock[]    @relation("ContentBlockUpdatedBy")
  contentRevisionsMade ContentRevision[] @relation("ContentRevisionCreatedBy")
  legalVersionsMade    LegalVersion[]    @relation("LegalVersionCreatedBy")
  mediaImagesMade      MediaImage[]      @relation("MediaImageCreatedBy")

  @@index([referredById])
}

// Auth.js (NextAuth) adapter tables. The model is named "Session" by Auth.js;
// our dated class occurrence is therefore called ClassSession.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Offerings, sessions, prices ----------

model Offering {
  id           String        @id @default(cuid())
  type         OfferingType
  title        String
  slug         String        @unique
  summary      String        @default("")
  body         String        @default("") // markdown
  image        String?
  mode         Mode          @default(ONLINE)
  location     String?
  published    Boolean       @default(false)
  eventPricing EventPricing? // only for type EVENT
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Phase 12 (admin): editable fields. All optional or with a default, so old rows stay valid.
  imageAlt               String? // alt text of `image`
  level                  String? // e.g. "All levels"
  minutes                Int? // session length in minutes (data, not a booking rule)
  lengthLabel            String? // e.g. "30 min"
  activationAfterMinutes Int? // greeting first, main part starts this many minutes after the start
  sortOrder              Int       @default(0)
  adminEditedAt          DateTime? // set when an admin edits the row: seeds must skip it

  sessions     ClassSession[]
  priceOptions PriceOption[]

  @@index([type, published])
}

// One dated occurrence of an offering. 1:1 slots are ClassSession rows with capacity 1
// (no separate AvailabilitySlot table: one booking engine for classes, 1:1 and events).
model ClassSession {
  id         String        @id @default(cuid())
  offeringId String
  offering   Offering      @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  startsAt   DateTime // UTC
  endsAt     DateTime // UTC
  capacity   Int           @default(1)
  zoomUrl    String?
  location   String?
  status     SessionStatus @default(SCHEDULED)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  bookings Booking[]

  @@unique([offeringId, startsAt]) // one occurrence per offering and start time (idempotent demo seed)
  @@index([offeringId, startsAt])
  @@index([startsAt])
}

model PriceOption {
  id          String   @id @default(cuid())
  offeringId  String
  offering    Offering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  name        String // e.g. "Single class", "Online 1:1"
  amountCents Int
  currency    String   @default("EUR")
  createdAt   DateTime @default(now())

  @@index([offeringId])
}

// Class pack / 1:1 pack
model Package {
  id         String         @id @default(cuid())
  name       String
  credits    Int
  validDays  Int
  priceCents Int
  currency   String         @default("EUR")
  appliesTo  OfferingType[]
  active     Boolean        @default(true)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  creditGrants CreditGrant[]
}

model CreditGrant {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  packageId      String?
  package        Package?       @relation(fields: [packageId], references: [id], onDelete: SetNull)
  creditsTotal   Int
  creditsLeft    Int
  expiresAt      DateTime?
  expiredAt      DateTime? // set by the daily cron when the unused credits were removed
  creditsExpired Int            @default(0) // how many unused credits the cron removed
  appliesTo      OfferingType[] @default([GROUP_CLASS]) // copied from the package when granted
  source         CreditSource
  createdAt      DateTime       @default(now())

  bookings Booking[]
  referral Referral? // set when this grant is a referral reward

  @@index([userId, expiresAt])
}

// ---------- Bookings and orders ----------

model Booking {
  id                   String        @id @default(cuid())
  userId               String
  user                 User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  sessionId            String
  session              ClassSession  @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  status               BookingStatus @default(PENDING)
  paidWith             PaidWith?
  creditGrantId        String?
  creditGrant          CreditGrant?  @relation(fields: [creditGrantId], references: [id], onDelete: SetNull)
  disclaimerAcceptedAt DateTime?
  reminderSentAt       DateTime? // 24 h reminder (daily cron); set once
  // Database guarantees against double booking (NULL when the booking is not active):
  //   userKey = "<sessionId>:<userId>" -> the same person cannot hold two seats in one session
  //   slotKey = "<sessionId>"          -> only for capacity-1 sessions (1:1): one active booking per slot
  userKey              String?       @unique
  slotKey              String?       @unique
  orderId              String?
  order                Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([userId])
  @@index([sessionId, status])
  @@index([orderId])
}

model Order {
  id                    String        @id @default(cuid())
  userId                String? // guests may pay (donations): then email is used
  user                  User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  email                 String
  status                OrderStatus   @default(PENDING)
  currency              String        @default("EUR")
  subtotalCents         Int           @default(0)
  discountCents         Int           @default(0)
  totalCents            Int           @default(0)
  discountCodeId        String?
  discountCode          DiscountCode? @relation(fields: [discountCodeId], references: [id], onDelete: SetNull)
  stripeSessionId       String?       @unique
  stripePaymentIntentId String? // saved by the webhook; used for refunds
  paidAt                DateTime?
  refundStartedAt       DateTime? // set when a Stripe refund was started for this order (REFUNDED comes later from the webhook)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  items    OrderItem[]
  bookings Booking[]

  @@index([userId])
  @@index([email])
  @@index([stripePaymentIntentId])
}

model OrderItem {
  id             String        @id @default(cuid())
  orderId        String
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type           OrderItemType
  description    String
  quantity       Int           @default(1)
  unitPriceCents Int
  totalCents     Int
  refId          String? // id of the session / package / offering this line is for

  @@index([orderId])
}

// Idempotency for the Stripe webhook (one row per processed Stripe event id).
model StripeEvent {
  id          String   @id // Stripe event id
  type        String
  processedAt DateTime @default(now())
}

model DiscountCode {
  id             String       @id @default(cuid())
  code           String       @unique
  kind           DiscountKind
  percentOff     Int? // for PERCENT
  amountOffCents Int? // for AMOUNT
  maxUses        Int?
  usedCount      Int          @default(0)
  expiresAt      DateTime?
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())

  orders Order[]
}

// ---------- Referral, content, newsletter ----------

model Referral {
  id                  String         @id @default(cuid())
  referrerId          String
  referrer            User           @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referredUserId      String         @unique // one reward per new client
  referredUser        User           @relation("ReferredUser", fields: [referredUserId], references: [id], onDelete: Cascade)
  status              ReferralStatus @default(PENDING)
  rewardCreditGrantId String?        @unique
  rewardCreditGrant   CreditGrant?   @relation(fields: [rewardCreditGrantId], references: [id], onDelete: SetNull)
  createdAt           DateTime       @default(now())

  @@index([referrerId])
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  text      String
  published Boolean  @default(true)
  createdAt DateTime @default(now())

  // Phase 12 (admin)
  place     String? // e.g. "Dublin"
  isDemo    Boolean  @default(false) // true = shown with the "Demo review" label
  sortOrder Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt
}

model NewsletterSubscriber {
  id           String           @id @default(cuid())
  email        String           @unique
  status       SubscriberStatus @default(PENDING)
  consentAt    DateTime?
  confirmToken String?          @unique
  source       String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
  readAt    DateTime? // set when an admin clicks "Mark as read" (task 12.7). NULL = unread
}

model SiteSetting {
  key   String @id
  value String
}

// Who changed what in the admin (task 12.3). One row per admin action. Rows are never deleted or edited.
// `summary` is a short sentence: no secrets, no Zoom links, no email addresses of clients.
model AdminAuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String // e.g. "slots.add"
  entity    String // e.g. "ClassSession"
  entityId  String?
  summary   String   @default("")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
  @@index([userId])
}

// ---- Phase 12: editable texts (task 12.4). Code defaults stay in content/*; these tables only hold what an admin changed. ----

enum ContentKind {
  TEXT
  INLINE // one line, only *italic*
  MARKDOWN
  META // SEO / Open Graph text
  ALT // image alt text
  URL
}

enum LegalStatus {
  DRAFT
  PUBLISHED
}

// One editable text. `key` never changes after it is in the DB (see docs/admin/text-keys.md).
model ContentBlock {
  id          String      @id @default(cuid())
  key         String      @unique // e.g. "home.hero.title"
  value       String
  kind        ContentKind @default(TEXT)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  updatedById String?
  updatedBy   User?       @relation("ContentBlockUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedById])
}

// History: one row per save (and per restore). Never edited, never deleted. `key` is plain text on purpose (no FK).
model ContentRevision {
  id          String   @id @default(cuid())
  key         String
  value       String
  note        String   @default("")
  createdAt   DateTime @default(now())
  createdById String?
  createdBy   User?    @relation("ContentRevisionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([key, createdAt])
  @@index([createdById])
}

// Legal pages: every publish is a new version; old versions stay (plan 14.5).
model LegalVersion {
  id             String      @id @default(cuid())
  slug           String // booking-cancellation, terms, privacy, cookies, health-disclaimer
  version        Int
  title          String
  body           String // markdown, may contain rule tokens
  status         LegalStatus @default(DRAFT)
  lawyerApproved Boolean     @default(false)
  approvedAt     DateTime?
  publishedAt    DateTime?
  note           String      @default("")
  createdAt      DateTime    @default(now())
  createdById    String?
  createdBy      User?       @relation("LegalVersionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([slug, version])
  @@index([slug, status])
  @@index([createdById])
}

// Image library (task 12.12): one row per uploaded image (always saved as WebP). Alt text is required.
// Rows are never deleted: "old images are never removed". `url` is "/uploads/<file>" (local folder) or the Vercel Blob URL.
model MediaImage {
  id          String   @id @default(cuid())
  url         String   @unique
  alt         String
  storage     String // "local" or "blob"
  width       Int
  height      Int
  bytes       Int // size of the saved WebP file
  createdAt   DateTime @default(now())
  createdById String?
  createdBy   User?    @relation("MediaImageCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([createdById])
}
