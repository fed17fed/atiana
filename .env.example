# Copy to .env (never commit .env). Values are added later unless noted.

# Neon PostgreSQL (set in Phase 0)
DATABASE_URL=
DIRECT_URL=

# Auth.js magic link login (task 2.3). Login is OFF until AUTH_SECRET, AUTH_RESEND_KEY (or RESEND_API_KEY) and EMAIL_FROM are set.
AUTH_SECRET=
AUTH_URL=
# Resend key used for the login email. If empty, RESEND_API_KEY is used instead.
AUTH_RESEND_KEY=
# LOCAL TESTING ONLY. "true" shows a dev login for @atiana.test users. Ignored when NODE_ENV=production or on Vercel.
# Never set this on Vercel.
ALLOW_DEV_LOGIN=

# Stripe (keys added later, test mode). Payments are OFF until BOTH STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET are set.
# Webhook URL to add in Stripe: <site>/api/stripe/webhook (events: checkout.session.completed, checkout.session.expired, charge.refunded)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Resend (keys added later)
RESEND_API_KEY=
EMAIL_FROM=

# Cloudflare Turnstile (keys added later)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Vercel Blob (added later when images are uploaded)
BLOB_READ_WRITE_TOKEN=

# Site (task 3.6)
# Public base URL for canonical links, sitemap and Open Graph (default: Vercel domain or localhost)
NEXT_PUBLIC_SITE_URL=
# Demo site is hidden from search engines. Set to true only at go-live.
ALLOW_INDEXING=
# Contact form (task 3.3): where admin emails go. Email is off until RESEND_API_KEY, EMAIL_FROM and this are set.
CONTACT_TO_EMAIL=

# Daily cron (task 4.7): Vercel sends this as "Authorization: Bearer <CRON_SECRET>". The route stays closed (503) when empty.
# Use a long random value. Set it in Vercel project settings (Production).
CRON_SECRET=

# Class packs are hidden on the site until the owner sets new pack prices. Set to "true" to show them again.
SHOW_PACKS=
